# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/
bin/
lib/
out/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# Scratch diagnostic logs dropped at the repo root by local tool runs. The `*.log` rule above misses
# these because they are named `*_log.txt`; pin_release_log.txt and statictest_log.txt reached main
# that way. Root-anchored so a genuine data file named `..._log.txt` under data/ is unaffected.
/*_log.txt

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
# NOTE: this used to be a bare `tests/`, which silently excluded the entire test tree from the
# repository -- including the CI job that runs it. Ignore test *output*, never test sources.
tests/**/output/
Testing/
.cache/

# Python bytecode (tools/ci/)
__pycache__/
*.py[cod]

# Claude Code hook state (.claude/hooks/*.py mark this stale on C++ edits, cleared on
# sr_tests runs -- local scratch, not repo content)
.claude/build-stale.flag

# IDEs and Editors
.vscode/
.idea/
*.vcxproj
*.sln
.vs/

# OS Files
.DS_Store
Thumbs.db
